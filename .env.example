# Copy this file to .env (never commit .env). Every variable the app reads is listed here.

# Signs the login cookie. Replace with any long random string.
SECRET_KEY=replace-with-a-long-random-string

PORT=5000
DATABASE_PATH=studio.db
FLASK_DEBUG=0

# The studio (owner) login. These are the values from the official seed file,
# so the default works as-is. The account is only created the first time the
# database is made; to change it later, delete studio.db and start again.
STUDIO_EMAIL=studio@artstudio.in
STUDIO_PASSWORD=Studio@123
